# Database Configuration for Single Database Setup
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aics_bicutan_system_db
DB_USERNAME=root
DB_PASSWORD=

# Security Configuration
# Set to 'true' to enforce HTTPS
FORCE_HTTPS=false

# Development/Production Mode
ENVIRONMENT=development

# Error Reporting
SHOW_ERRORS=true
LOG_ERRORS=true