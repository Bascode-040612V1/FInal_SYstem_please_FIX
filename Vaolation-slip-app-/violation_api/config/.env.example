# Database Configuration for Violation API
# Following project memory: Unified database 'aics_bicutan_system_db'
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aics_bicutan_system_db
DB_USERNAME=root
DB_PASSWORD=

# Security Configuration
# Set to 'true' to enforce HTTPS in production
FORCE_HTTPS=false

# Development/Production Mode
ENVIRONMENT=development

# Error Reporting & Logging
SHOW_ERRORS=true
LOG_ERRORS=true

# API Settings
API_VERSION=1.0
DEBUG_MODE=false